{
  "name": "nec2c-wasm",
  "version": "0.1.0",
  "description": "nec2c 1.3.1 (NEC-2 antenna modeling) compiled to WebAssembly, for Node and browsers",
  "keywords": ["nec2c", "nec2", "wasm", "webassembly", "antenna", "electromagnetics", "ham-radio"],
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runner.d.ts",
      "default": "./src/runner.mjs"
    },
    "./inline": {
      "types": "./src/runner.d.ts",
      "default": "./src/runner-inline.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/runner.mjs",
  "types": "./src/runner.d.ts",
  "files": [
    "src",
    "prebuilts",
    "third_party",
    "build.sh",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:wasm": "bash build.sh",
    "test:parity": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlieh0tel/nec2c-js.git",
    "directory": "packages/nec2c-wasm"
  },
  "homepage": "https://github.com/charlieh0tel/nec2c-js/tree/main/packages/nec2c-wasm"
}
