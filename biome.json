{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "files": {
    "ignore": [
      "packages/nec2c-deck/dist/**",
      "packages/nec2c-wasm/prebuilts/**",
      "packages/nec2c-wasm/third_party/**",
      "packages/nec2pp-wasm/prebuilts/**",
      "packages/nec2pp-wasm/third_party/**",
      "emsdk/**"
    ]
  }
}
